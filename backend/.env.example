# ============================================================
# EntryTech · Variables de entorno del backend
# Copia este archivo como .env y completa los valores.
# NUNCA subas el .env real al repositorio.
# ============================================================

# Puerto del servidor HTTP.
PORT=5000

# development | production
NODE_ENV=development

# --- Base de datos ---
# Opción A: cadena de conexión completa (Supabase, Neon, Railway...).
DATABASE_URL=postgresql://usuario:contrasena@host:5432/basedatos

# Opción B: parámetros sueltos (se ignoran si DATABASE_URL está definida).
# DB_USER=postgres
# DB_HOST=localhost
# DB_NAME=entrytech
# DB_PASSWORD=
# DB_PORT=5432

# Conexiones simultáneas del pool. El plan gratuito de Supabase es limitado.
DB_POOL_MAX=5

# --- Seguridad ---
# Obligatoria y de 32 caracteres como mínimo: en producción el servidor se
# niega a arrancar sin ella. Genérala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Duración de la sesión.
JWT_EXPIRES_IN=8h

# Orígenes autorizados para CORS, separados por comas. Sin este valor la API
# queda abierta a cualquier sitio web en desarrollo y rechaza todo en producción.
CORS_ORIGINS=http://localhost:5173,https://localhost:5173,https://entrytech.vercel.app

# Clave del terminal de acceso. Si se define, POST /api/acceso exige la
# cabecera X-Kiosk-Key o un token de sesión válido.
KIOSK_API_KEY=

# Tamaño máximo del cuerpo JSON (las fotos viajan en Base64).
JSON_LIMIT=3mb

# --- Fondo diario ---
# Clave de api.nasa.gov para la Imagen Astronómica del Día. Es gratuita y se
# obtiene al instante en https://api.nasa.gov
# Sin ella se usa DEMO_KEY, limitada a 30 peticiones por hora y 50 por día
# para toda la dirección IP: suficiente para desarrollo, no para producción.
# El resultado se cachea hasta el cambio de fecha, así que una clave propia
# cubre el tráfico de sobra.
NASA_API_KEY=
